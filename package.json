{
  "name": "hachan-cat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "build:ait": "tsc -b && vite build --configLoader runner && ait build",
    "preview": "vite preview --host 0.0.0.0 --configLoader runner",
    "test:movements": "node --experimental-strip-types scripts/verify-movements.mjs",
    "test:cards": "node --experimental-strip-types scripts/verify-card-faces.mjs",
    "test:social": "node scripts/verify-social-preview.mjs",
    "test:game-loop": "node --experimental-strip-types scripts/verify-game-loop.mjs",
    "test:duel": "node scripts/verify-duel-system.mjs && node --experimental-strip-types scripts/verify-duel-reactions.ts && node --experimental-strip-types scripts/verify-duel-nickname.ts",
    "test:duel:live": "node scripts/verify-duel-live.mjs",
    "test:duel:gestures": "node --env-file=.env.local scripts/verify-duel-gestures-live.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.4.1",
    "@fontsource/gaegu": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
